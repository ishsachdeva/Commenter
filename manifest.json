{
  "manifest_version": 3,
  "name": "LinkedIn Comment Helper",
  "version": "1.0.0",
  "description": "Inline LinkedIn AI comment assistant with in-page suggestions.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*",
    "https://openrouter.ai/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn Comment Helper"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "options_page": "options.html",
  "background": {
    "service_worker": "background.js"
  }
}
